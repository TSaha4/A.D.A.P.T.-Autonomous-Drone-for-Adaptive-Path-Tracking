WEATHER_API_BASE_URL="https://api.open-meteo.com/v1/forecast"
MAX_SAFE_WIND_SPEED=40.0
MAX_SAFE_PRECIPITATION=15.0
METERS_PER_PIXEL=2.0

# Mission planner tuning (see src/mission/constraints.py for sources)
FORECAST_MIN="30,60,120"
FLOOD_BACKEND="auto"
HOME_CANDIDATES=16
PATH_DOWNSAMPLE=5
DEFAULT_PACKAGE_KG=0.5

# Demo drone: DJI Mavic-class anchors (77 Wh / 46 min / 12 m/s cruise)
DRONE_BATTERY_WH=77.0
DRONE_ENDURANCE_MIN=46.0
DRONE_CRUISE_MPS=12.0
DRONE_PAYLOAD_CAPACITY_KG=2.0

