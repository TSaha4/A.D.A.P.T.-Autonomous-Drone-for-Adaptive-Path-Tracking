WEATHER_API_BASE_URL="https://api.open-meteo.com/v1/forecast"
MAX_SAFE_WIND_SPEED=40.0
MAX_SAFE_PRECIPITATION=15.0
# Ground metres covered by one pixel of the ORIGINAL input image (before display resizing)
METERS_PER_PIXEL=2.0
# Multi-base / multi-UAV mode (main.py --mode multi). MAX_BASES=1 restricts the planner to one base (one UAV).
MAX_BASES=4
# Minimum distance between two bases, and from a base to any flood pixel (display pixels)
MIN_BASE_SEPARATION_PX=150
HOME_CLEARANCE_PX=15
